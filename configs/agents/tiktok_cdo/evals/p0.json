{
  "schema_version": "agent-eval-cases.v1",
  "agent": "tiktok_cdo",
  "note": "只含确定性接缝。known_bug:true 的用例是 2026-10-27 实测确认的真实缺陷，允许失败（会单独计数），修好后把 known_bug 改成 false 并更新基线。",
  "cases": [
    {
      "id": "tiktok-001",
      "target": "tiktok_cdo.fallback_intent",
      "input": ["搜索 运动鞋"],
      "assert": [
        { "op": "equals", "path": "action", "value": "search" },
        { "op": "equals", "path": "keyword", "value": "运动鞋" },
        { "op": "equals", "path": "limit", "value": 10 },
        { "op": "is_none", "path": "username" }
      ],
      "origin": "src/data_intelligence_hub/agents/tiktok_cdo/intent.py:99-134（实测）"
    },
    {
      "id": "tiktok-002",
      "target": "tiktok_cdo.fallback_intent",
      "input": ["分析 #美妆 话题最近7天"],
      "assert": [
        { "op": "equals", "path": "action", "value": "hashtag" },
        { "op": "equals", "path": "keyword", "value": "美妆" }
      ],
      "origin": "prompts/system.md:26-27；intent.py:106-107（实测）"
    },
    {
      "id": "tiktok-003",
      "target": "tiktok_cdo.fallback_intent",
      "input": ["@alice"],
      "assert": [
        { "op": "equals", "path": "action", "value": "user_posts" },
        { "op": "equals", "path": "username", "value": "alice" },
        { "op": "is_none", "path": "keyword" }
      ],
      "origin": "intent.py:116-132（实测）"
    },
    {
      "id": "tiktok-004",
      "target": "tiktok_cdo.fallback_intent",
      "input": ["搜索运动鞋相关视频 top5"],
      "assert": [
        { "op": "equals", "path": "action", "value": "search" },
        { "op": "is_not_none", "path": "keyword" }
      ],
      "known_bug": true,
      "note": "回退层按空格切词，keyword 得到「运动鞋相关视频」而非「运动鞋」，且 limit 恒为 10（不解析 top5）。prompts/system.md:24-25 承诺 top5→limit 5，那是 LLM 层的能力，回退层给不了——提示词与回退能力不一致。",
      "origin": "intent.py:126-134（实测 keyword=运动鞋相关视频, limit=10）vs prompts/system.md:24-25"
    },
    {
      "id": "tiktok-005",
      "target": "tiktok_cdo.fallback_intent",
      "input": ["search skincare top5"],
      "assert": [
        { "op": "equals", "path": "action", "value": "search" }
      ],
      "known_bug": true,
      "note": "实测 keyword='search'：'search' 不在 skip_words 里（skip 只有中文指令词），于是英文指令词本身被当成关键词。英文输入的清洗缺失。",
      "origin": "intent.py:126-133（skip_words 只含中文，实测 keyword='search'）"
    },
    {
      "id": "tiktok-006",
      "target": "tiktok_cdo.fallback_intent",
      "input": ["hello @"],
      "assert": [
        { "op": "equals", "path": "raw_text", "value": "hello @" }
      ],
      "known_bug": true,
      "note": "实测抛 IndexError：'@' 在末尾时 parts[1] 不存在。空 handle 应视为无 handle，不能崩。",
      "origin": "intent.py:121-124（实测 IndexError）"
    },
    {
      "id": "tiktok-007",
      "target": "tiktok_cdo.fallback_intent",
      "input": ["搜索 olive oil"],
      "assert": [
        { "op": "equals", "path": "action", "value": "search" }
      ],
      "known_bug": true,
      "note": "实测返回 live：子串匹配 'live' 命中 'olive'。关键词表应按词边界匹配。",
      "origin": "intent.py:108-109（实测 '搜索 olive oil' → live）"
    },
    {
      "id": "tiktok-008",
      "target": "tiktok_cdo.fallback_intent",
      "input": [""],
      "assert": [
        { "op": "equals", "path": "action", "value": "unknown" }
      ],
      "known_bug": true,
      "note": "实测返回 search：空输入不该被当成搜索意图，应为 unknown。",
      "origin": "intent.py:99-134（实测空串 → search）"
    },
    {
      "id": "tiktok-009",
      "target": "tiktok_cdo.fallback_intent",
      "input": ["find @alice's followers"],
      "assert": [
        { "op": "equals", "path": "action", "value": "followers" },
        { "op": "equals", "path": "username", "value": "alice" }
      ],
      "known_bug": true,
      "note": "实测 username=\"alice's\"：只按空格切分，没剥标点。",
      "origin": "intent.py:121-132（实测）"
    },
    {
      "id": "tiktok-010",
      "target": "tiktok_cdo.build_tool_call",
      "input": [{ "action": "search", "keyword": "x", "limit": 5 }],
      "assert": [
        { "op": "equals", "path": "0", "value": "tiktok_video_search" },
        { "op": "equals", "path": "1.query", "value": "x" },
        { "op": "equals", "path": "1.limit", "value": 5 }
      ],
      "origin": "tests/unit/test_tiktok_cdo_tool_migration.py::test_build_tool_call_for_content_actions（实测）"
    },
    {
      "id": "tiktok-011",
      "target": "tiktok_cdo.build_tool_call",
      "input": [{ "action": "user_posts", "username": "@alice", "limit": 3 }],
      "assert": [
        { "op": "equals", "path": "0", "value": "tiktok_creator_profile" },
        { "op": "equals", "path": "1.handle", "value": "alice" },
        { "op": "equals", "path": "1.include_videos", "value": true },
        { "op": "equals", "path": "1.video_limit", "value": 3 }
      ],
      "origin": "tests/unit/test_tiktok_cdo_tool_migration.py（@ 前缀要剥掉，实测）"
    },
    {
      "id": "tiktok-012",
      "target": "tiktok_cdo.build_tool_call",
      "input": [{ "action": "hashtag", "keyword": "美妆" }],
      "assert": [
        { "op": "equals", "path": "0", "value": "tiktok_hashtag_videos" },
        { "op": "equals", "path": "1.hashtag", "value": "美妆" }
      ],
      "origin": "tests/unit/test_tiktok_cdo_tool_migration.py（实测）"
    },
    {
      "id": "tiktok-013",
      "target": "tiktok_cdo.build_tool_call",
      "input": [{ "action": "creator", "keyword": "x" }],
      "assert": [
        { "op": "equals", "path": "0", "value": "tiktok_creator_profile" },
        { "op": "equals", "path": "1.include_videos", "value": false }
      ],
      "origin": "src/data_intelligence_hub/agents/tiktok_cdo/tool_router.py（实测）"
    },
    {
      "id": "tiktok-014",
      "target": "tiktok_cdo.build_tool_call",
      "input": [{ "action": "ads_search", "keyword": "美妆", "limit": 10 }],
      "assert": [
        { "op": "is_none", "path": "." }
      ],
      "origin": "tool_router.py:19-25（工具层不覆盖广告类，返回 None 由调用方回退，实测）"
    },
    {
      "id": "tiktok-015",
      "target": "tiktok_cdo.build_collect_params",
      "input": [{ "action": "search", "keyword": "x", "limit": 5 }],
      "assert": [
        { "op": "equals", "path": "0.0", "value": "tikhub_tiktok_video_search" },
        { "op": "equals", "path": "0.1.keyword", "value": "x" },
        { "op": "equals", "path": "0.1.max_items", "value": 5 }
      ],
      "origin": "src/data_intelligence_hub/agents/tiktok_cdo/endpoint_router.py（实测）"
    },
    {
      "id": "tiktok-016",
      "target": "tiktok_cdo.build_collect_params",
      "input": [{ "action": "ads_search", "keyword": "美妆", "limit": 10 }],
      "assert": [
        { "op": "equals", "path": "0.0", "value": "tikhub_tiktok_top_ads" },
        { "op": "equals", "path": "0.1.period", "value": 7 }
      ],
      "origin": "endpoint_router.py + docs/architecture/【技术方案】TikTok采集能力R1 §C4（实测含 top_ads）"
    },
    {
      "id": "tiktok-017",
      "target": "tiktok_cdo.system_prompt",
      "assert": [
        { "op": "is_not_none", "path": "." },
        { "op": "contains", "path": ".", "value": "action" },
        { "op": "not_contains", "path": ".", "value": "{{" }
      ],
      "origin": "configs/agents/registry.json（tiktok_cdo prompt sha256=467ce525…）；tests/unit/test_agent_prompts.py"
    }
  ]
}
