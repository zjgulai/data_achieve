[
 {
  "gate_id": "G0",
  "name": "Decision Charter",
  "purpose": "先冻结业务选择、证据边界与停损条件，再允许采集。",
  "entry": [
   "stakeholder request 已记录",
   "无上游 gate"
  ],
  "inputs": [
   "business question",
   "decision owner",
   "product / market / time window / channel",
   "budget / deadline / publication boundary"
  ],
  "steps": [
   {
    "action": "把业务问题改写成一个可判定的选择",
    "actor": "human",
    "check": ""
   },
   {
    "action": "指定唯一 decision owner 与唯一决策问题",
    "actor": "human",
    "check": ""
   },
   {
    "action": "为每个 sample frame 写用途与分母规则",
    "actor": "human",
    "check": ""
   },
   {
    "action": "写 QA 阈值（semantic / identity governance）",
    "actor": "human",
    "check": ""
   },
   {
    "action": "序列化 charter 并校验必填字段",
    "actor": "code",
    "check": "charter_schema"
   }
  ],
  "outputs": [
   "voc-research-charter.json",
   "metric-intent-and-denominator-rules.json",
   "qa-thresholds.json",
   "gate-plan.json"
  ],
  "accept": [
   "唯一 decision owner 与唯一决策问题被命名",
   "每个 frame 有 purpose 与 denominator rule",
   "exact-variant metric 声明需要 verified review-variant 证据",
   "QA 阈值是数值且按字段区分",
   "外部调用与发布边界显式",
   "stop condition 可机器检查"
  ],
  "rollback": "产品范围、决策 owner、市场、发布边界或预算变化时回到 G0。",
  "fail_closed": [
   "任何采集",
   "任何对外发布"
  ],
  "owner": "business decision owner",
  "machine_checks": [
   "charter_required_fields",
   "qa_thresholds_numeric",
   "frame_purpose_unique"
  ],
  "human_decisions": [
   "decision question",
   "owner",
   "budget",
   "publication boundary"
  ]
 },
 {
  "gate_id": "G1",
  "name": "Product Identity",
  "purpose": "把目标 SKU / variant 与 marketplace / social 标识冻结成可审计映射。",
  "entry": [
   "G0 = PASS，或 G0 = CONDITIONAL 且只授权 research-only 范围"
  ],
  "inputs": [
   "voc-research-charter.json",
   "official product URL or catalog record",
   "candidate identifiers"
  ],
  "steps": [
   {
    "action": "抓取官方 PDP / catalog 原始响应并保存 hash",
    "actor": "code",
    "check": "identity_raw_hash"
   },
   {
    "action": "解析 parent / child / variant / legacy / adjacent",
    "actor": "code",
    "check": "identity_parse"
   },
   {
    "action": "对模糊匹配做人工裁决并写 confidence",
    "actor": "human",
    "check": ""
   },
   {
    "action": "隔离 legacy 与 adjacent",
    "actor": "human",
    "check": ""
   }
  ],
  "outputs": [
   "product-identity-crosswalk.json",
   "variant-matrix.csv",
   "identity-evidence-ledger.json",
   "identity-quarantine.json"
  ],
  "accept": [
   "target SKU 与 variant 显式",
   "marketplace parent / child 角色分离",
   "legacy 与 adjacent 被隔离",
   "每个 mapping 带证据、时间戳、confidence 与 review status"
  ],
  "rollback": "出现新 child ASIN、SKU、bundle、颜色、尺码或 legacy 映射变化时回到 G1。",
  "fail_closed": [
   "exact-variant metric",
   "variant-specific 结论"
  ],
  "owner": "research lead + catalog owner",
  "machine_checks": [
   "identity_parent_child_consistent",
   "identity_timestamp_present",
   "identity_variants_unique"
  ],
  "human_decisions": [
   "fuzzy match adjudication",
   "legacy / adjacent quarantine"
  ]
 },
 {
  "gate_id": "G2",
  "name": "Source and Rights Audit",
  "purpose": "每个来源先写清能回答什么、不能回答什么、权利与隐私状态。",
  "entry": [
   "G1 = PASS"
  ],
  "inputs": [
   "G0 charter",
   "G1 identity crosswalk",
   "candidate source inventory"
  ],
  "steps": [
   {
    "action": "逐源登记 rights / privacy / commerciality / content role",
    "actor": "human",
    "check": ""
   },
   {
    "action": "写 allowed use 与 forbidden use",
    "actor": "human",
    "check": ""
   },
   {
    "action": "把 blocked source 写入 register",
    "actor": "code",
    "check": "blocked_source_out_of_denominator"
   }
  ],
  "outputs": [
   "source-rights-matrix.json",
   "source-role-contract.json",
   "privacy-and-retention-plan.md",
   "blocked-source-register.json"
  ],
  "accept": [
   "每个来源有 rights 与 privacy 状态",
   "商业与创作者内容被隔离出 organic consumer metric",
   "allowed / forbidden use 显式",
   "blocked source 不能进入下游分母"
  ],
  "rollback": "endpoint、权利状态、披露、访问路径或发布用途变化时回到 G2。",
  "fail_closed": [
   "blocked source 的记录进入 metric row"
  ],
  "owner": "legal / privacy owner",
  "machine_checks": [
   "every_source_has_rights_state",
   "blocked_not_in_metric"
  ],
  "human_decisions": [
   "rights state",
   "allowed use",
   "retention"
  ]
 },
 {
  "gate_id": "G3",
  "name": "Source Pilot",
  "purpose": "先 inspect 再 run，用小样本验证产品匹配、字段、重复与成本。",
  "entry": [
   "G2 = PASS，或 G2 = CONDITIONAL 且有显式 allowed use 与 blocked register"
  ],
  "inputs": [
   "G0 budget",
   "G1 identity",
   "G2 source contract",
   "provider / endpoint candidates"
  ],
  "steps": [
   {
    "action": "inspect endpoint：字段、分页、地区、评论层、限制",
    "actor": "code",
    "check": "inspect_before_run"
   },
   {
    "action": "最小 run 并保存不可变 raw",
    "actor": "code",
    "check": "raw_immutable"
   },
   {
    "action": "对账记录数、zero result、错误与成本",
    "actor": "code",
    "check": "ledger_reconciles"
   },
   {
    "action": "给每个来源写 scorecard 与 limitation",
    "actor": "llm_assisted",
    "check": ""
   },
   {
    "action": "接受或拒绝该来源",
    "actor": "human",
    "check": ""
   }
  ],
  "outputs": [
   "pilot-raw/",
   "monid-run-ledger.json",
   "pilot-source-scorecard.json",
   "pilot-gate-decision.json"
  ],
  "accept": [
   "run 之前已有 inspect 记录",
   "成本在 G0 上限内",
   "raw 响应不可变且与 ledger 关联",
   "conditional source 有显式 limitation 与 next action"
  ],
  "rollback": "权利/角色问题回 G2；产品不匹配回 G1；预算或范围变化回 G0。",
  "fail_closed": [
   "扩量采集"
  ],
  "owner": "research lead",
  "machine_checks": [
   "inspect_run_order",
   "cost_within_ceiling",
   "raw_hash_present",
   "zero_results_visible"
  ],
  "human_decisions": [
   "source accept / reject",
   "conditional limitation"
  ]
 },
 {
  "gate_id": "G4",
  "name": "Taxonomy Freeze",
  "purpose": "把定义、include / exclude 规则、枚举与 exact-variant 谓词冻结成可执行合同。",
  "entry": [
   "G3 = PASS 或 CONDITIONAL"
  ],
  "inputs": [
   "pilot records",
   "research questions",
   "category terminology",
   "G0 metric rules"
  ],
  "steps": [
   {
    "action": "从 pilot 归纳 aspect / context / journey / outcome / gap 轴",
    "actor": "llm_assisted",
    "check": ""
   },
   {
    "action": "为每个 code 写定义、include、exclude",
    "actor": "human",
    "check": ""
   },
   {
    "action": "写 machine enums 与 exact-variant predicate",
    "actor": "code",
    "check": "enum_contract_complete"
   },
   {
    "action": "迁移 pilot 编码并对账",
    "actor": "code",
    "check": "pilot_migration_reconciles"
   },
   {
    "action": "冻结版本号并出 gate decision",
    "actor": "human",
    "check": ""
   }
  ],
  "outputs": [
   "taxonomy.json",
   "codebook.md",
   "alias-map.json",
   "pilot-coded.jsonl",
   "taxonomy-coverage.json",
   "consumer-metric-view-contract.json",
   "social-governance-rules.json",
   "g7-calibration-plan.json",
   "g4-gate-decision.json"
  ],
  "accept": [
   "定义与 include / exclude 完整",
   "unknown 与 negative / absent 分开",
   "mixed 保留正负两个 component",
   "machine contract 定义合法枚举与 exact-variant 谓词",
   "G7 plan 读取 G0 阈值并把风险建模为 coverage",
   "pilot migration 与 source inventory 对账"
  ],
  "rollback": "反复不可编码证据或 code collision 超过阈值时，带新 taxonomy 版本回到 G4。",
  "fail_closed": [
   "G5 扩量",
   "任何 prevalence"
  ],
  "owner": "taxonomy owner + research lead",
  "machine_checks": [
   "every_code_has_definition",
   "enum_unknown_present",
   "pilot_migration_reconciles"
  ],
  "human_decisions": [
   "code definitions",
   "include / exclude",
   "freeze"
  ]
 },
 {
  "gate_id": "G5",
  "name": "Stratified Collection",
  "purpose": "按 frame 分层采集，保留空格、零结果与成本，杜绝只采到能采的。",
  "entry": [
   "G4 = PASS"
  ],
  "inputs": [
   "G0 sample plan",
   "G1 identity",
   "G2 contracts",
   "G3 endpoints",
   "G4 taxonomy"
  ],
  "steps": [
   {
    "action": "生成 collection matrix（frame × source × query × quota）",
    "actor": "code",
    "check": "matrix_complete"
   },
   {
    "action": "按矩阵执行采集并逐条写 ledger",
    "actor": "code",
    "check": "every_raw_has_request"
   },
   {
    "action": "保留 missing / zero-result cell",
    "actor": "code",
    "check": "missing_cells_visible"
   },
   {
    "action": "对账成本与记录数",
    "actor": "code",
    "check": "cost_reconciles"
   }
  ],
  "outputs": [
   "collection-matrix.json",
   "raw/",
   "collection-run-ledger.json",
   "quota-and-gap-report.json",
   "raw-manifest.sha256"
  ],
  "accept": [
   "每个 raw object 可追溯到一个批准请求",
   "missing 与 zero-result cell 保持可见",
   "frame membership 显式且可重叠不重复计数",
   "成本与记录总数对账"
  ],
  "rollback": "endpoint 漂移回 G3；权利漂移回 G2；产品匹配恶化回 G1。",
  "fail_closed": [
   "G6"
  ],
  "owner": "collection operator",
  "machine_checks": [
   "quota_cells_present",
   "raw_manifest_matches",
   "cost_reconciles"
  ],
  "human_decisions": [
   "quota acceptance"
  ]
 },
 {
  "gate_id": "G6",
  "name": "Canonicalize and Deduplicate",
  "purpose": "把 raw / occurrence / canonical / membership 四个数分开，并让每个扣减有理由。",
  "entry": [
   "G5 = PASS 或 CONDITIONAL"
  ],
  "inputs": [
   "raw corpus + manifest",
   "identity crosswalk",
   "source-role contract",
   "taxonomy ids"
  ],
  "steps": [
   {
    "action": "raw → occurrence：按 source + external id + frame 建 occurrence",
    "actor": "code",
    "check": "occurrence_unique"
   },
   {
    "action": "exact dedup：规范化文本 hash",
    "actor": "code",
    "check": "exact_group_one_representative"
   },
   {
    "action": "fuzzy 候选：相似度阈值以上进入 review",
    "actor": "code",
    "check": "fuzzy_requires_review"
   },
   {
    "action": "确定性选代表并写 duplicate group",
    "actor": "code",
    "check": "representative_deterministic"
   },
   {
    "action": "写 exclusion 与 metric eligibility",
    "actor": "code",
    "check": "exclusion_reason_present"
   },
   {
    "action": "对账 98→96→95 式血缘",
    "actor": "code",
    "check": "reconciliation_balances"
   }
  ],
  "outputs": [
   "canonical-voc-record.schema.json",
   "occurrences.jsonl",
   "canonical-records.jsonl",
   "duplicate-groups.json",
   "lineage-edges.jsonl",
   "metric-eligibility-manifest.jsonl",
   "exclusion-quarantine.jsonl",
   "g6-reconciliation.json"
  ],
  "accept": [
   "raw / occurrence / canonical / membership 数互不混用",
   "每个 canonical 至少链接一个 occurrence",
   "每条记录满足 canonical schema 与 G4 enum",
   "每个 duplicate group 恰好一个代表",
   "metric eligibility 与 exclusion 机器可读",
   "代表选择确定性可复现"
  ],
  "rollback": "新来源暴露新重复组或规范化规则变化时回到 G6，并保留旧版本。",
  "fail_closed": [
