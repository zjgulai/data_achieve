APP_NAME=Data Intelligence Hub API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://data_intel:dev_password@localhost:5432/data_intel

JWT_SECRET=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Production compose maps SCRAPY_SMTP_* from /opt/data-achieve-scrapy/.env.production
# into these SMTP_* settings inside the api container.

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

DATASET_EXPORT_DIR=tmp/dataset-exports

SCHEDULER_ENABLED=false
SCHEDULER_POLL_INTERVAL_SECONDS=60

# 本地默认离线；restricted 只允许固定 Provider 和已获服务端范围批准的 HTTP 采集。
# 不受控跨站扫描器不能通过该开关解锁。详见 docs/standards/collection-outbound-safety.md。
COLLECTION_NETWORK_MODE=offline
COLLECTION_HTTP_GRANTS=[]

# TikHub API Key (https://tikhub.io)
# Required for TikTok / Instagram / Xiaohongshu collection via tikhub_social collector
# TIKHUB_API_KEY=

# Apify API Token (https://apify.com)
# Required for Apify Actor collection via apify_actor collector
# APIFY_API_TOKEN=

# Platform credential vault master key (Fernet base64-urlsafe, 32 bytes)
# Required for /settings/platforms credential storage (revision 035+)
# PLATFORM_CREDENTIAL_MASTER_KEY=

# 数说（Shushuo）飞书机器人
# 事件回调地址：https://<host>/api/agents/shusuo/webhook
# LARK_SHUSUO_APP_ID=
# LARK_SHUSUO_APP_SECRET=
# LARK_SHUSUO_VERIFICATION_TOKEN=
# LARK_SHUSUO_ENCRYPT_KEY=
# 默认写入的项目（必须存在于 demo workspace）
# SHUSUO_DEFAULT_PROJECT_ID=7fd6ed55-7b0c-5482-92f3-d03130168b70
# SHUSUO_CONSOLE_BASE_URL=https://scrapy.luteos.com
# 可选：逗号分隔的 open_id 白名单；留空表示租户内可用
# SHUSUO_ALLOWED_OPEN_IDS=
