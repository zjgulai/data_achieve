   "任何以 canonical 数当消费者数的表述"
  ],
  "owner": "data engineer",
  "machine_checks": [
   "one_representative_per_group",
   "canonical_has_occurrence",
   "reconciliation_balances"
  ],
  "human_decisions": [
   "fuzzy duplicate adjudication"
  ]
 },
