{
  "version": "2026-06-15",
  "dataset": "curated_training",
  "content_contract": {
    "required_source_fields": [
      "id",
      "project_key",
      "category",
      "collector_type",
      "config",
      "source_url",
      "title",
      "risk_level",
      "training_use",
      "content_targets"
    ],
    "required_snapshot_fields": [
      "source_id",
      "collector_type",
      "source_url",
      "collected_at",
      "status",
      "content"
    ],
    "required_intelligence_fields": [
      "title",
      "category",
      "claim",
      "impact",
      "recommended_action",
      "evidence_urls",
      "last_checked_at"
    ],
    "quality_rules": {
      "forbidden_visible_terms": [
        "sample",
        "placeholder",
        "demo-",
        "demo_",
        "example only",
        "示例",
        "样本"
      ],
      "min_sources": 20,
      "min_raw_records": 40,
      "min_entities": 30,
      "min_signals": 12,
      "min_intelligence_items": 12,
      "min_reports": 1
    },
    "page_contract": {
      "/dashboard": ["overview_metrics", "recent_intelligence", "risk_alerts"],
      "/projects": ["training_projects"],
      "/sources": ["training_sources"],
      "/tasks": ["collection_tasks"],
      "/raw-records": ["source_snapshots"],
      "/entities": ["tool_entities", "platform_method_entities"],
      "/signals": ["trend_signals", "risk_signals"],
      "/intelligence": ["training_intelligence_items"],
      "/reports": ["training_report"],
      "/alerts": ["training_alerts"],
      "/notifications": ["training_notifications"]
    }
  },
  "projects": [
    {
      "key": "open-source-collection",
      "name": "Open Source Collection Radar",
      "domain": "osint",
      "description": "Track public crawler, scraping, browser automation, and extraction tools."
    },
    {
      "key": "platform-methods",
      "name": "Platform Collection Methods",
      "domain": "platform",
      "description": "Maintain training cards for public and compliant collection methods across major platforms."
    },
    {
      "key": "agent-collection-ecosystem",
      "name": "Agent Collection Ecosystem",
      "domain": "agent",
      "description": "Track AI agent, tool-use, MCP, and browser-agent collection capabilities."
    },
    {
      "key": "compliance-boundary",
      "name": "Compliance Boundary Radar",
      "domain": "governance",
      "description": "Surface data minimization, robots, platform policy, and personal data boundaries."
    }
  ],
