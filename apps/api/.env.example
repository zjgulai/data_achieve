APP_NAME=Data Intelligence Hub API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://data_intel:dev_password@localhost:5432/data_intel

JWT_SECRET=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

SCHEDULER_ENABLED=false
SCHEDULER_POLL_INTERVAL_SECONDS=60
